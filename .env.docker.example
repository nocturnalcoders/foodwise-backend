# Copy to .env next to docker-compose.yml:  cp .env.docker.example .env
# Generate secrets with:  openssl rand -hex 32

POSTGRES_PASSWORD=change-me-letters-and-numbers-only
JWT_SECRET=change-me-to-a-long-random-string
ALLOWED_ORIGINS=https://foodwise-murex.vercel.app,http://localhost:5173

# Optional: AI photo scan and recipes (paid per use)
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-haiku-5-5
# Or use Gemini instead (free key from https://aistudio.google.com). Used when set.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Host ports (only on 127.0.0.1). Change if another app on the droplet uses them.
API_PORT=8001
DB_PORT=5433

# Optional: "Continue with Google". Web client ID from Google Cloud Console.
GOOGLE_CLIENT_ID=
# Optional: "Continue with Apple". Your Apple Services ID (needs a paid Apple Developer account).
APPLE_CLIENT_ID=
