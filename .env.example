# Copy to .env for local development. On Render, add these as Environment Variables.

# Database. Leave empty to use a local SQLite file (foodwise.db).
# For production, paste the Supabase "Session pooler" connection string.
DATABASE_URL=

# Any long random string. Used to sign login tokens. Keep it secret.
JWT_SECRET=change-me-to-a-long-random-string

# Websites allowed to call this API (comma separated).
ALLOWED_ORIGINS=https://foodwise-murex.vercel.app,http://localhost:5173

# Optional: enables photo scan and AI recipes. Leave empty to turn AI off.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-haiku-5-5
